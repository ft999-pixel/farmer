# 複製這個檔案為 .env，把值填進去。.env 已列入 .gitignore，不會進版本庫。
# ⚠️ 金鑰不要貼到聊天、群組或截圖裡。

# Anthropic（語意抽取與公文翻譯；沒填也能跑，會降級為關鍵字模式）
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# LINE 官方帳號（LINE Developers → Messaging API 頁籤）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 補助資料維護後台（/app/admin.html）。沒填＝後台不啟用，不會有無密碼的後門。
ADMIN_PASSWORD=
# 登入 cookie 的簽章金鑰。沒填則每次啟動隨機產生（重啟後要重新登入）。
ADMIN_SECRET=
