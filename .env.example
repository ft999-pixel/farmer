# 複製這個檔案為 .env，把值填進去。.env 已列入 .gitignore，不會進版本庫。
# ⚠️ 金鑰不要貼到聊天、群組或截圖裡。

# Anthropic（語意抽取與公文翻譯；沒填也能跑，會降級為關鍵字模式）
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# LINE 官方帳號（LINE Developers → Messaging API 頁籤）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE 登入（農民端）。⚠️ 這是「LINE Login」channel，與上面的 Messaging API 是
# 不同的 channel，憑證也不同。沒填的話登入頁會自動改用代號登入。
# 回呼網址要在 LINE Developers 的 Callback URL 也填一份：
#   本機 http://127.0.0.1:8000/members/line/callback
#   線上 https://你的網域/members/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 部署後網域與本機不同時可覆寫（留空則自動推導）
LINE_LOGIN_REDIRECT_URI=

# 補助資料維護後台（/app/admin.html）。沒填＝後台不啟用，不會有無密碼的後門。
ADMIN_PASSWORD=
# 登入 cookie 的簽章金鑰。沒填則每次啟動隨機產生（重啟後要重新登入）。
ADMIN_SECRET=
